{
  "manifest_version": 3,
  "name": "Phishing Detection Plugin",
  "version": "0.1.29",
  "description": "Blocks highly likely phishing attempts based on a dynamic rule set",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "plugin.js",
    "scripts": ["plugin.js"],
    "type": "module"
  },
  "host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "shield_48.png", "shield_512.png"],
      "matches": ["*://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self';"
  },
  "icons": {
    "48": "shield_48.png",
    "128": "shield_128.png",
    "512": "shield_512.png"
  },
  "action": {
    "default_icon": "shield_48.png",
    "default_title": "Phishing Detection Plugin",
    "default_popup": "report.html"
  },
  "options_page": "settings.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdp_gecko@yoeri.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "id": "pdp_gecko_android@yoeri.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
